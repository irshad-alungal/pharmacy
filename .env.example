# Browser config lives in assets/js/supabase-client.js (URL + publishable key only).
# Server-side secrets (Edge Functions only, set via `supabase secrets set`):
# SUPABASE_SERVICE_ROLE_KEY=...   WHATSAPP_TOKEN=...   WHATSAPP_PHONE_ID=...
# Billing AI assistant (supabase/functions/billing-assistant):
# ANTHROPIC_API_KEY=...           ANTHROPIC_MODEL=claude-sonnet-5-5   (model is optional)
